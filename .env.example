# Local development only. Copy to .env and choose a unique local password.
POSTGRES_USER=voicelink_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password

# Standard speech providers. Confirm Groq Free and Gemini API Free Tier before enabling.
# These values must be loaded into the application process environment; Compose does not do that.
VOICELINK_STANDARD_FREE_TIER_CONFIRMED=false
VOICELINK_GROQ_API_KEY=replace-with-groq-free-key
VOICELINK_GEMINI_API_KEY=replace-with-gemini-api-key

# Optional paid Gemini translation and voice. Keep disabled until owner configures a separate billed project.
VOICELINK_PREMIUM_ENABLED=false
VOICELINK_PREMIUM_GEMINI_API_KEY=
