# Local development only. Copy to .env and choose a unique local password.
POSTGRES_USER=voicelink_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password

# Standard speech providers. Confirm Groq Free and Azure F0 resources before enabling.
# These values must be loaded into the application process environment; Compose does not do that.
VOICELINK_STANDARD_FREE_TIER_CONFIRMED=false
VOICELINK_GROQ_API_KEY=replace-with-groq-free-key
VOICELINK_AZURE_TRANSLATOR_KEY=replace-with-azure-translator-f0-key
VOICELINK_AZURE_TRANSLATOR_REGION=replace-with-azure-region
VOICELINK_AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
VOICELINK_AZURE_SPEECH_KEY=replace-with-azure-speech-f0-key
VOICELINK_AZURE_SPEECH_REGION=replace-with-azure-region
